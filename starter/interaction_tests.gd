extends RefCounted

static func tap(s,code):
	s.keys([code],true);await s.frames(3);s.keys([code],false);await s.frames(3)

static func run(s,graphical:bool):
	var d=s.get_node("LearningInteractions")
	if not d.has_method("restart"):
		s.check(false,"full interaction lifecycle missing")
		return
	d.restart();await s.frames(90)
	var original=s.angle
	s.player.position=d.token.position+Vector3(0,0,2.0);await s.frames(3)
	await tap(s,KEY_E)
	s.check(not d.collected,"E outside pickup radius does nothing")
	s.check(is_equal_approx(s.angle,original),"E does not orbit camera")
	s.player.position=d.token.position+Vector3(0,0,0.5);await s.frames(3)
	await tap(s,KEY_E)
	s.check(d.collected and d.pickup_count==1 and not d.token.visible,"E collects and hides exactly one token")
	s.keys([KEY_E],true);await s.frames(20)
	var echo_event=InputEventKey.new();echo_event.keycode=KEY_E;echo_event.physical_keycode=KEY_E;echo_event.pressed=true;echo_event.echo=true;Input.parse_input_event(echo_event)
	await s.frames(3);s.keys([KEY_E],false);await s.frames(3)
	await tap(s,KEY_E)
	s.check(d.pickup_count==1,"hold echo and repeated E cannot duplicate pickup")
	s.player.position=d.checkpoint.position+Vector3(0,0,2.0);await s.frames(3);await tap(s,KEY_E)
	s.check(not d.checkpoint_active,"checkpoint rejects out-of-range input")
	s.player.position=d.checkpoint.position+Vector3(0,0,0.5);await s.frames(3);await tap(s,KEY_E)
	s.check(d.checkpoint_active,"E activates nearby checkpoint")
	if graphical:await s.shot("checkpoint_active")
	s.player.position.y=-50;await s.frames(100)
	s.check(s.player.is_on_floor() and Vector2(s.player.position.x-d.checkpoint.position.x,s.player.position.z-d.checkpoint.position.z).length()<0.1,"real fall respawns at active checkpoint on terrain")
	s.check(d.collected and d.pickup_count==1,"respawn retains collected token")
	s.player.position=s.SPAWN;await s.frames(90);await tap(s,KEY_R);await s.frames(90)
	s.check(s.player.position.distance_to(d.respawn_position)<0.1,"ordinary R uses checkpoint")
	await tap(s,KEY_2)
	s.check(d.checkpoint_active and d.collected,"character switch keeps session progress")
	s.player.position=d.display.position+Vector3(0,0,0.6);await s.frames(3);await tap(s,KEY_E)
	s.check(d.message.begins_with("Teknium laser gun"),"E inspects identified gun prop without combat")
	s.check(d.prompt.text.contains("No firing or combat"),"inspection result is visible, not just internal state")
	s.check(d.display.get_node("GunMesh").mesh.get_surface_count()>0,"recovered gun mesh and textures load")
	var gun=d.display.get_node("GunMesh")
	var bounds:AABB=gun.transform*gun.get_aabb()
	s.check(bounds.size.x>bounds.size.y,"gun display preserves horizontal barrel silhouette")
	if graphical:await s.shot("gun_inspect")
	await tap(s,KEY_F);await s.frames(90)
	s.check(not d.collected and d.pickup_count==0 and d.token.visible and not d.checkpoint_active,"F restarts collectible and checkpoint")
	s.check(Vector2(s.player.position.x-s.SPAWN.x,s.player.position.z-s.SPAWN.z).length()<0.1,"full restart returns to original spawn")
	s.player.position=d.token.position;await s.frames(3);await tap(s,KEY_E)
	s.check(d.pickup_count==1,"pickup works again after full reset")
	original=s.angle;s.keys([KEY_Q],true);await s.frames(30);s.keys([KEY_Q],false);await s.frames(3)
	s.check(s.angle<original-0.5,"Q still orbits left")
	original=s.angle;s.keys([KEY_C],true);await s.frames(30);s.keys([KEY_C],false);await s.frames(3)
	s.check(s.angle>original+0.5,"C now orbits right")
	d.restart();s.angle=PI;await s.frames(90)
	if graphical:await s.shot("v3_ready")
